# Adresse publique du site (sert pour les liens dans les emails)
SITE_URL=https://lyon1-en-lutte.example.org
PORT=3000
NODE_ENV=production
# Derrière un hébergeur (Render, Railway, Fly…) : mettre true pour lire la vraie IP des visiteurs
TRUST_PROXY=true

# Premier compte admin (créé au premier démarrage)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-moi-tout-de-suite
# Clé de signature des sessions (sinon générée et gardée dans data/secret)
SESSION_SECRET=

# IA : lecture des comptes rendus PDF (sinon extraction simple sans IA)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Emails d'alerte : Resend (recommandé) OU SMTP
RESEND_API_KEY=
MAIL_FROM=Lyon 1 en lutte <alertes@ton-domaine.org>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Délai de regroupement des alertes bâtiments (ms) : 10 bâtiments changés = 1 seul email
ALERT_DELAY_MS=60000

# Données (fichier JSON + fichiers téléversés). À mettre sur un disque persistant.
DATA_DIR=./data
# Taille max d'une vidéo de témoignage (Mo)
MAX_VIDEO_MB=150
# Votes max par réseau et par heure sur un même scrutin (wifi de campus partagé)
VOTES_PER_NETWORK_HOUR=40
# Mots refusés dans le chat, séparés par des virgules
CHAT_BANNED_WORDS=
