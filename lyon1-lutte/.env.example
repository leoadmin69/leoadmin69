# Adresse publique du site (sert pour les liens dans les emails)
SITE_URL=https://ladoua-en-lutte.example.org
PORT=3000
NODE_ENV=production
# Derrière un hébergeur (Render, Railway, Fly…) : mettre true pour lire la vraie IP des visiteurs
TRUST_PROXY=true

# Premier compte admin (créé au premier démarrage)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-moi-tout-de-suite
# Clé de signature des sessions (sinon générée et gardée dans data/secret)
SESSION_SECRET=

# IA GRATUITE pour lire les comptes rendus PDF. Mets au moins une clé ; elles sont essayées dans l'ordre,
# et si l'une a épuisé son quota gratuit, la suivante prend le relais. Sans clé : extraction simple sans IA.
# 1) Google Gemini, gratuit : https://aistudio.google.com/apikey  (lit aussi les PDF scannés / manuscrits)
GEMINI_API_KEY=
# 2) Groq, gratuit : https://console.groq.com/keys  (très rapide, lit le texte du PDF, pas les scans)
GROQ_API_KEY=
# Le meilleur modèle gratuit disponible est choisi automatiquement. Pour forcer : GEMINI_MODEL=… / GROQ_MODEL=…
# Ordre des IA (par défaut gemini,groq,anthropic). Ex. pour passer Groq en premier : AI_PROVIDERS=groq,gemini
# AI_PROVIDERS=gemini,groq,anthropic
# 3) Claude (payant, facultatif)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Emails d'alerte : Resend (recommandé) OU SMTP
RESEND_API_KEY=
MAIL_FROM=Lyon 1 · La Doua en lutte <alertes@ton-domaine.org>
# Compte Instagram affiché sur le site, dans les emails et sur les stories
INSTAGRAM_URL=https://www.instagram.com/lyon1_ladoua.enlutte/
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Délai de regroupement des alertes bâtiments (ms) : 10 bâtiments changés = 1 seul email
ALERT_DELAY_MS=60000

# Stockage permanent GRATUIT quand l'hébergeur n'a pas de disque (Render gratuit) : Supabase (supabase.com)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Emails gratuits SANS nom de domaine : Brevo (300/jour). L'adresse d'envoi doit être validée dans Brevo.
BREVO_API_KEY=
MAIL_FROM_EMAIL=

# Données (fichier JSON + fichiers téléversés). À mettre sur un disque persistant.
DATA_DIR=./data
# Taille max d'une vidéo de témoignage (Mo). Par défaut 45 avec Supabase gratuit (limite 50), 150 sinon.
# MAX_VIDEO_MB=45
# Votes max par réseau et par heure sur un même scrutin (wifi de campus partagé)
VOTES_PER_NETWORK_HOUR=40
# Mots refusés dans le chat, séparés par des virgules
CHAT_BANNED_WORDS=
