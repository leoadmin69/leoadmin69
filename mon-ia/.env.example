# ---- Modèle de langage (n'importe quelle API compatible OpenAI) ----
# Plus simple : laisse ce bloc vide et ajoute tes modèles dans Admin → Modèles (plusieurs fournisseurs, rôles ⚡/🧠, secours).
# Google Gemini : gratuit, très grand contexte → LE MEILLEUR CHOIX pour travailler sur des sites
# Clé : https://aistudio.google.com/apikey
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=xxx
LLM_MODEL=nom-du-modele-flash   # liste à jour : https://ai.google.dev/gemini-api/docs/models

# Alternatives gratuites :
# Groq (ultra rapide, mais limites strictes pour le code) : LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=llama-3.3-70b-versatile
# OpenRouter (modèles :free, dont des modèles spécialisés code) : LLM_BASE_URL=https://openrouter.ai/api/v1  LLM_MODEL=<un modèle « :free »>  (liste : https://openrouter.ai/models?q=free)
# Ollama (sur ton PC, 100 % local) : LLM_BASE_URL=http://localhost:11434/v1  LLM_API_KEY=ollama  LLM_MODEL=qwen2.5-coder:14b

# ---- Administration ----
ADMIN_PASSWORD=change-moi-tout-de-suite
PORT=3000
# PUBLIC_CHAT=true   # laisser des visiteurs discuter (sans accès aux projets ni à la mémoire)
# DATA_DIR=/data     # dossier de stockage (ex : disque persistant)
TZ=Africa/Tunis      # fuseau horaire des missions programmées

# ---- Sauvegarde automatique de la mémoire (recommandé sur les hébergeurs gratuits) ----
# Dépôt GitHub PRIVÉ dédié + jeton « Contents : Read and write » limité à ce dépôt.
# BACKUP_GITHUB_REPO=ton-pseudo/nova-memoire
# BACKUP_GITHUB_TOKEN=github_pat_xxx
# BACKUP_MINUTES=10
