# ---- Modèle de langage (n'importe quelle API compatible OpenAI) ----
# Groq (gratuit, très rapide) : https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_xxx
LLM_MODEL=llama-3.3-70b-versatile

# Alternatives gratuites :
# OpenRouter : LLM_BASE_URL=https://openrouter.ai/api/v1   LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Google Gemini : LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   LLM_MODEL=gemini-2.0-flash
# Ollama (sur ton PC, 100 % local) : LLM_BASE_URL=http://localhost:11434/v1   LLM_API_KEY=ollama   LLM_MODEL=qwen2.5:7b

# ---- Administration ----
ADMIN_PASSWORD=change-moi-tout-de-suite
PORT=3000
